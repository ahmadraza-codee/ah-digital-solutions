# AH Digital Solutions — required env vars (set in Vercel: Project → Settings → Environment Variables).
# Copy to .env.local for local testing. NEVER commit real values.

# Supabase Postgres connection string (pooler or direct). Required for quote
# submissions, inquiries and admin content overrides.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Admin panel password (choose a strong one). Required for /admin login.
ADMIN_PASSWORD=

# Long random secret used to sign admin session JWTs (e.g. openssl rand -hex 32).
ADMIN_SESSION_SECRET=

# Resend API key for new-quote email alerts. Optional — the site works without
# it (inquiries are still saved in the database).
RESEND_API_KEY=

# Sender address for the alert email. Optional. Without a verified domain,
# Resend only delivers to the Resend account owner's email, so the Resend
# account must be registered with ahmadraza3430178@gmail.com.
RESEND_FROM=AH Digital Solutions <onboarding@resend.dev>
