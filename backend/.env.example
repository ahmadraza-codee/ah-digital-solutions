# AH Digital Solutions backend — environment variables.
# Copy to .env for local dev. NEVER commit a real .env with values.
# On Render, set these in Dashboard > Service > Environment (same values
# as the Vercel env vars for the Next.js app, except PORT / FRONTEND_URL).

# Supabase Postgres pooled connection string (port 6543 pooler).
# Copy the exact value from Vercel env var DATABASE_URL.
DATABASE_URL=

# Admin password — copy the exact value from Vercel env var ADMIN_PASSWORD.
ADMIN_PASSWORD=

# JWT signing secret — copy the exact value from Vercel env var ADMIN_SESSION_SECRET.
ADMIN_SESSION_SECRET=

# Resend API key for new-quote email alerts (optional, fail-soft).
# Copy from Vercel env var RESEND_API_KEY once Resend signup is done.
RESEND_API_KEY=

# Optional sender for Resend emails. Defaults to onboarding@resend.dev.
RESEND_FROM=AH Digital Solutions <onboarding@resend.dev>

# Frontend origin allowed by CORS. Default is the live Vercel site.
FRONTEND_URL=https://ah-digital-solutions.vercel.app

# Port. Render sets PORT automatically — do not set it on Render.
# Local dev default is 3001.
PORT=3001

# NODE_ENV=production on Render (set automatically by render.yaml).
NODE_ENV=production
